# Hermes + GBrain Railway new-agent values template
# Copy to .agent-envs/<agent-slug>.env and keep private.
# .agent-envs/ is gitignored.

# User-provided: display name shown in Hermes/Slack/admin surfaces.
AGENT_DISPLAY_NAME=replace_me

# Railway-provided/user-provided: target project and service names.
RAILWAY_PROJECT_NAME=replace_me
RAILWAY_SERVICE_NAME=replace_me

# User-provided: Hermes admin login username.
ADMIN_USERNAME=admin

# Generated or user-provided: Hermes admin password.
ADMIN_PASSWORD=replace_me

# Slack-provided: fresh Slack app credentials for this agent.
SLACK_BOT_TOKEN=replace_me
SLACK_APP_TOKEN=replace_me

# Slack-provided: the allowed Slack member/user and home channel IDs.
SLACK_ALLOWED_USER_ID=replace_me
SLACK_HOME_CHANNEL_ID=replace_me

# OpenAI-provided: key used by GBrain embeddings, not Codex OAuth.
OPENAI_API_KEY=replace_me

# Generated/default starter values.
LLM_MODEL=gpt-5.5
HERMES_INFERENCE_PROVIDER=openai-codex
HERMES_CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
HOME=/data
HERMES_HOME=/data/.hermes
BUN_INSTALL=/data/.bun
GBRAIN_HOME=/data/.gbrain
GBRAIN_BRAIN_DIR=/data/brain

# Optional GBrain source override. Leave unset unless a non-default source is required.
# GBRAIN_SOURCE=replace_me
